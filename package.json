{
  "name": "tronosa-static",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:test": "cross-env APP_ENV=staging SITE_URL=https://example.com SEO_INDEXING_ENABLED=false NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT= next build",
    "start": "next start",
    "start:test": "cross-env NODE_ENV=production APP_ENV=staging SITE_URL=https://example.com SEO_INDEXING_ENABLED=false NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT= next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run src tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:a11y": "playwright test --grep @a11y",
    "test:regression": "pnpm test:coverage && pnpm test:e2e",
    "test:security": "playwright test --grep @security",
    "test:reliability": "playwright test --grep @reliability",
    "test:csp": "playwright test --grep @csp",
    "test:contact": "playwright test --grep @contact",
    "test:performance": "lhci autorun",
    "test:performance:collect": "lhci collect",
    "test:performance:assert": "lhci assert",
    "test:performance:report": "lhci upload",
    "check:dependencies": "pnpm peers check",
    "check:security": "pnpm audit",
    "check:security:prod": "pnpm audit --prod",
    "check:git": "git diff --check && git diff --cached --check",
    "check:secrets": "gitleaks git --redact --no-banner",
    "check:secrets:staged": "gitleaks git --staged --redact --no-banner",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm typecheck:reliability && pnpm test:coverage && pnpm build:test",
    "verify:full": "pnpm verify && pnpm test:e2e && pnpm check:dependencies && pnpm check:git",
    "verify:security": "pnpm check:security:prod && pnpm check:security",
    "prepare": "husky",
    "analyze": "next experimental-analyze",
    "typecheck:reliability": "tsc --project tests/reliability/tsconfig.json",
    "test:reliability:smoke": "k6 run tests/reliability/scenarios/smoke.ts",
    "test:reliability:light-load": "k6 run tests/reliability/scenarios/light-load.ts",
    "test:reliability:load": "k6 run tests/reliability/scenarios/load.ts",
    "test:reliability:heavy-load": "k6 run tests/reliability/scenarios/heavy-load.ts",
    "test:reliability:stress": "k6 run tests/reliability/scenarios/stress.ts",
    "test:reliability:spike": "k6 run tests/reliability/scenarios/spike.ts",
    "test:reliability:capacity": "k6 run tests/reliability/scenarios/capacity.ts",
    "test:reliability:business-spike": "k6 run tests/reliability/scenarios/business-spike.ts",
    "test:reliability:soak": "k6 run tests/reliability/scenarios/soak.ts",
    "test:reliability:recovery": "k6 run tests/reliability/scenarios/recovery.ts"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@hcaptcha/react-hcaptcha": "^2.2.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "3.15.1",
    "maplibre-gl": "^6.18.0",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "swiper": "^14.4.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/k6": "^2.3.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "cross-env": "10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.6.0"
}
