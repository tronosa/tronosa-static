# Automatically detect text files and normalize them in Git
* text=auto

# Source code
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf

# Stylesheets
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.less text eol=lf

# Markup
*.html text eol=lf
*.xml text eol=lf
*.svg text eol=lf

# Configuration
*.json text eol=lf
*.jsonc text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.lock text eol=lf

# Environment files
.env text eol=lf
.env.* text eol=lf

# Git and tooling configuration
.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf
.npmrc text eol=lf
.prettierignore text eol=lf

# Documentation
*.md text eol=lf
*.mdx text eol=lf
*.txt text eol=lf

# Shell scripts and Git hooks
*.sh text eol=lf
.husky/** text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=lf

# Binary images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary

# Binary fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Binary media
*.mp4 binary
*.webm binary
*.mov binary
*.mp3 binary
*.wav binary
*.riv binary

# Binary documents and archives
*.pdf binary
*.zip binary
*.gz binary